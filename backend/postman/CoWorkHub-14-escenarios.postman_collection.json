    {
      "name": "Escenario 1 - Reserva con dos servicios (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/reservas",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "reservas"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"roomId\": 1, \"memberId\": 1, \"startTime\": \"{{futureDate}}T16:00:00\", \"endTime\": \"{{futureDate}}T17:00:00\", \"attendees\": 4, \"services\": [{\"serviceId\": 1, \"quantity\": 1}, {\"serviceId\": 2, \"quantity\": 1}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const d=new Date(Date.now()+7*86400000); const parts=new Intl.DateTimeFormat('en-CA',{timeZone:'America/Bogota',year:'numeric',month:'2-digit',day:'2-digit'}).format(d); pm.environment.set('futureDate',parts);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status esperado 201\", () => pm.response.to.have.status(201));",
              "pm.environment.set(\"bookingId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
