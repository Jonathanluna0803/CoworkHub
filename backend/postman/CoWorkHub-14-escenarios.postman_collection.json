        "url": {
          "raw": "http://localhost:8080/api/reservas",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "reservas"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"roomId\": 3, \"memberId\": 3, \"startTime\": \"{{cancel30}}\", \"endTime\": \"{{cancel30End}}\", \"attendees\": 2}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const s=new Date(Date.now()+30*3600000); const e=new Date(Date.now()+31*3600000); const f=(d)=>new Intl.DateTimeFormat('en-CA',{timeZone:'America/Bogota',year:'numeric',month:'2-digit',day:'2-digit'}).format(d); const t=(d)=>new Intl.DateTimeFormat('en-GB',{timeZone:'America/Bogota',hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).format(d); pm.environment.set('cancel30',f(s)+'T'+t(s)+':00'); pm.environment.set('cancel30End',f(e)+'T'+t(e)+':00');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status esperado 201\", () => pm.response.to.have.status(201));",
              "pm.environment.set(\"cancel30BookingId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
