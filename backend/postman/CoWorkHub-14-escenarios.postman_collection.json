          "raw": "http://localhost:8080/api/reservas",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "reservas"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"roomId\": 1, \"memberId\": 5, \"startTime\": \"{{futureDate}}T16:00:00\", \"endTime\": \"{{futureDate}}T17:00:00\", \"attendees\": 1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Ejecutar simultáneamente con el escenario 1 para validar el bloqueo por sala. Si se ejecuta después, debe responder 409 por el solapamiento."
