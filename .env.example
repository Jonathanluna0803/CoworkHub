# Copy this file to .env and replace every placeholder with a unique value.
MYSQL_DATABASE=coworkhub
MYSQL_USER=coworkhub
MYSQL_PASSWORD=replace-with-a-strong-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-local-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
